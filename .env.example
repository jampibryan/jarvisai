# Copia este archivo a .env. Completa solo la clave del proveedor que quieras usar.
# Opciones: gemini, deepseek, off (solo comandos locales).
JARVIS_AI_PROVIDER=gemini

JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash

JARVIS_DEEPSEEK_API_KEY=
JARVIS_DEEPSEEK_MODEL=deepseek-flash

# Guarda comandos y respuestas en la base local. Usa 0 para dejar de registrar.
JARVIS_RECORD_HISTORY=1

# Cambios de archivos del Explorador. Usa 1 para aplicarlos tras confirmarlos.
JARVIS_APPLY_FILE_CHANGES=0

# auto prefiere Whisper local cuando está instalado; whisper exige el modelo local.
JARVIS_VOICE_ENGINE=auto
